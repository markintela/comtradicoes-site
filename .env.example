# ─────────────────────────────────────────────────────────────
#  Configuração do SERVIDOR (dados secretos — nunca no browser)
#  Copie este ficheiro para ".env.local" e preencha.
# ─────────────────────────────────────────────────────────────

# Modo de demonstração do MB WAY: "true" simula os pagamentos (não cobra nada).
MBWAY_MOCK=true

# Chave MB WAY atribuída pela ifthenpay
MBWAY_KEY=

# Endpoints da API MB WAY v2 da ifthenpay (confirme-os com a ifthenpay)
MBWAY_API_URL=https://api.ifthenpay.com/spg/payment/mbway
MBWAY_STATUS_URL=https://api.ifthenpay.com/spg/payment/mbway/status

# Chave anti-phishing do callback (opcional)
MBWAY_CALLBACK_KEY=

# Pasta onde ficam gravados os pedidos e as mensagens (ficheiros JSON)
PASTA_DADOS=./dados
